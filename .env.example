# Port used on your server; the container always listens on 8787.
DOCKERS_PORT=8787
# Use 127.0.0.1 when your reverse proxy runs directly on this same server.
DOCKERS_BIND_ADDRESS=0.0.0.0
# Exact origins, no path or trailing slash. Add your public HTTPS origin.
DOCKERS_ORIGINS=https://danielleurquin.github.io,https://dockersgame.ma-soluce.com
